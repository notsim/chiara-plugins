{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chiara Plugin Manifest",
  "description": "Manifest di un plugin dichiarativo (no-code) per Chiara.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "trigger", "actions"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "icon": { "type": "string", "description": "URL o percorso dell'icona/foto del plugin." },
    "category": { "type": "string", "description": "Categoria del plugin (es. Food, Produttività, Developer, Community)." },
    "author": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "tier": { "enum": ["free", "ultra"] },
    "location": {
      "type": "object",
      "description": "Area geografica servita dal plugin (es. per attività locali come pizzerie o barbieri).",
      "properties": {
        "city": { "type": "string", "description": "Città principale (es. Milano, Roma, Napoli)" },
        "province": { "type": "string", "description": "Sigla provincia (es. MI, RM, NA)" },
        "cap": { "type": "array", "items": { "type": "string" }, "description": "Elenco CAP coperti per consegne" }
      }
    },
    "permissions": {
      "type": "array",
      "description": "Permessi di accesso ai dati dell'utente (es. phone, name, email, address).",
      "items": { "type": "string" }
    },
    "endpoint": {
      "type": "object",
      "description": "Configurazione endpoint esterno per webhook aziendali/servizi esterni.",
      "required": ["url"],
      "properties": {
        "url": { "type": "string" },
        "method": { "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"] },
        "secret": { "type": "string" },
        "headers": { "type": "object" }
      }
    },
    "trigger": {
      "type": "object",
      "oneOf": [
        {
          "required": ["type", "pattern"],
          "properties": {
            "type": { "const": "regex" },
            "pattern": { "type": "string" },
            "flags": { "type": "string" }
          }
        },
        {
          "required": ["type", "command"],
          "properties": {
            "type": { "const": "command" },
            "command": { "type": "string" }
          }
        },
        {
          "required": ["type", "intent"],
          "properties": {
            "type": { "const": "intent" },
            "intent": { "type": "string" }
          }
        }
      ]
    },
    "data": {
      "type": "array",
      "description": "Dataset del plugin: ogni riga ha una chiave `key` e campi liberi (usati con l'azione `lookup`).",
      "items": {
        "type": "object",
        "required": ["key"],
        "properties": { "key": { "type": "string" } },
        "additionalProperties": true
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/action" }
    }
  },
  "definitions": {
    "action": {
      "type": "object",
      "oneOf": [
        { "required": ["type", "template"], "properties": { "type": { "const": "reply" }, "template": { "type": "string" } } },
        { "required": ["type", "options"], "properties": { "type": { "const": "random" }, "options": { "type": "array", "items": { "type": "string" }, "minItems": 1 } } },
        { "required": ["type", "tool"], "properties": { "type": { "const": "tool" }, "tool": { "type": "string" }, "input": { "type": "string" }, "template": { "type": "string" } } },
        { "required": ["type", "key"], "properties": { "type": { "const": "lookup" }, "key": { "type": "string" }, "template": { "type": "string" }, "fallback": { "type": "string" } } },
        { "required": ["type", "key"], "properties": { "type": { "const": "store" }, "key": { "type": "string" }, "value": { "type": "string" } } },
        { "required": ["type", "key"], "properties": { "type": { "const": "read" }, "key": { "type": "string" }, "template": { "type": "string" } } },
        { "required": ["type", "variable"], "properties": { "type": { "const": "set" }, "variable": { "type": "string" }, "value": { "type": "string" } } },
        { "required": ["type", "variable", "prompt"], "properties": { "type": { "const": "ask" }, "variable": { "type": "string" }, "prompt": { "type": "string" } } },
        { "required": ["type"], "properties": { "type": { "const": "http" }, "url": { "type": "string" }, "method": { "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"] }, "body": { "type": ["object", "string"] }, "headers": { "type": "object" }, "resultVariable": { "type": "string" }, "template": { "type": "string" }, "fallback": { "type": "string" } } },
        { "required": ["type", "variable", "then"], "properties": { "type": { "const": "if" }, "variable": { "type": "string" }, "equals": { "type": "string" }, "contains": { "type": "string" }, "then": { "type": "array", "items": { "$ref": "#/definitions/action" } }, "else": { "type": "array", "items": { "$ref": "#/definitions/action" } } } },
        { "required": ["type", "id"], "properties": { "type": { "const": "goto" }, "id": { "type": "string" } } },
        { "required": ["type", "id"], "properties": { "type": { "const": "label" }, "id": { "type": "string" } } },
        { "required": ["type"], "properties": { "type": { "const": "end" } } }
      ]
    }
  }
}
